<mxfile host="app.diagrams.net">
  <diagram name="Network" id="soc-homelab-network">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageWidth="900" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Internet -->
        <mxCell id="internet" value="Internet" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#548235;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="355" y="15" width="190" height="60" as="geometry" />
        </mxCell>

        <!-- Gateway -->
        <mxCell id="gateway" value="Gateway (UTM Shared Network)&#10;192.168.100.15" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#7F7F7F;" vertex="1" parent="1">
          <mxGeometry x="320" y="112" width="260" height="42" as="geometry" />
        </mxCell>

        <mxCell id="e_internet_gateway" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="internet" target="gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Host boundary -->
        <mxCell id="host" value="MacBook Pro (M1 Pro) — UTM — all VMs on Shared Network 192.168.100.0/24" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;dashed=1;fillColor=#FAFAFA;strokeColor=#999999;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="50" y="188" width="800" height="470" as="geometry" />
        </mxCell>

        <!-- DC01 -->
        <mxCell id="dc01" value="DC01&#10;Windows Server 2025&#10;Domain Controller + DNS&#10;192.168.100.10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#2E75B6;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="105" y="300" width="150" height="88" as="geometry" />
        </mxCell>

        <!-- WS01 -->
        <mxCell id="ws01" value="WS01&#10;Windows 11 Pro&#10;Domain-joined client&#10;192.168.100.20" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#2E75B6;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="305" y="300" width="150" height="88" as="geometry" />
        </mxCell>

        <!-- wazuh -->
        <mxCell id="wazuh" value="docker01&#10;Ubuntu Server&#10;Wazuh SIEM + Docker&#10;192.168.100.30" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#C55A11;fontColor=#833C00;" vertex="1" parent="1">
          <mxGeometry x="505" y="300" width="150" height="88" as="geometry" />
        </mxCell>

        <!-- kali (planned) -->
        <mxCell id="kali" value="kali (planned)&#10;Kali Linux&#10;Attack machine&#10;192.168.100.40" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FBE5E5;strokeColor=#C00000;fontColor=#C00000;" vertex="1" parent="1">
          <mxGeometry x="665" y="300" width="150" height="88" as="geometry" />
        </mxCell>

        <!-- Bus line connecting all VMs to gateway -->
        <mxCell id="e_gateway_dc01" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#7F7F7F;" edge="1" parent="1" source="gateway" target="dc01">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_gateway_ws01" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#7F7F7F;" edge="1" parent="1" source="gateway" target="ws01">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_gateway_wazuh" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#7F7F7F;" edge="1" parent="1" source="gateway" target="wazuh">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_gateway_kali" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#7F7F7F;dashed=1;" edge="1" parent="1" source="gateway" target="kali">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Traffic flows -->
        <mxCell id="e_ws01_dc01" value="login / policies" style="html=1;endArrow=block;fontSize=11;strokeColor=#555555;" edge="1" parent="1" source="ws01" target="dc01">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_dc01_wazuh" value="sends logs" style="html=1;endArrow=block;fontSize=11;strokeColor=#555555;" edge="1" parent="1" source="dc01" target="wazuh">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_ws01_wazuh" value="sends logs" style="html=1;endArrow=block;fontSize=11;strokeColor=#555555;" edge="1" parent="1" source="ws01" target="wazuh">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_kali_dc01" value="attacks (planned)" style="html=1;endArrow=block;fontSize=11;strokeColor=#C00000;dashed=1;" edge="1" parent="1" source="kali" target="dc01">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_kali_wazuh" value="should be detected in" style="html=1;endArrow=block;fontSize=11;strokeColor=#C00000;dashed=1;" edge="1" parent="1" source="kali" target="wazuh">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend1" value="Windows (AD domain)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#2E75B6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="635" width="150" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend2" value="Linux / SIEM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#C55A11;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="250" y="635" width="150" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend3" value="Planned" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#FBE5E5;strokeColor=#C00000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="635" width="150" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
